{
  // Use local Biome schema from node_modules
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  // Respect .gitignore (skips node_modules/, coverage/, etc.). dist/ is the
  // generated bundle, and fixtures are data, not source: hand-made trees are
  // kept byte-for-byte.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!dist", "!.claude", "!fixtures"]
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "noDuplicateClasses": "on"
      }
    }
  },

  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },

  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  }
}
